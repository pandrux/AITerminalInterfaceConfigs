// ai-workbench.kdl — Two-tab AI CLI layout for Zellij
//
// Tab 1 "AI" — three AI CLIs, side by side. F9 sync broadcasts here.
// ┌─ Claude ───┬─ Codex ────┬─ Gemini ───┐
// │            │            │            │
// │  claude    │  codex     │  gemini    │
// │            │            │            │
// └────────────┴────────────┴────────────┘
//
// Tab 2 "Scratch" — isolated shell. Not affected by F9 sync.
// ┌─ bash ──────────────────────────────┐
// │                                     │
// └─────────────────────────────────────┘
//
// Launch: ai   (function in shell/wsl-additions.sh, or scripts/ai.sh)
//   Both cd to the AI root first (the grandparent of this repo: /mnt/c/AI,
//   /mnt/d/AI, ...) so panes open there. The layout sets no cwd of its own,
//   so a bare `zellij --layout ai-workbench` opens panes wherever you run it.
// Toggle broadcast: F9 (only syncs panes in the current tab)
// Switch tabs: Ctrl+T then n/p (next/prev) or 1/2

layout {
    tab name="AI" focus=true {
        pane split_direction="vertical" {
            pane name="Claude" command="bash" {
                args "-lc" "claude"
                focus true
            }
            pane name="Codex" command="bash" {
                args "-lc" "codex"
            }
            pane name="Gemini" command="bash" {
                args "-lc" "gemini"
            }
        }
    }
    tab name="Scratch" {
        pane name="Scratch"
    }
}
